{
  "name": "mendcash",
  "version": "0.1.0",
  "private": true,
  "description": "AI dispute desk for PayPal merchants. AI reads the messy text, code does the math, you approve.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json --noEmit && vite build",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test src/*.test.ts src/*/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.7",
    "vite": "^6.4.5"
  }
}
