# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app, used by verify-webhook-signature
PAYPAL_WEBHOOK_ID=
# Fallback merchant id. Leave empty to read purchase_units[0].payee.merchant_id from GET /v2/checkout/orders/{id}.
# Set it when that field is missing. Render: sync false, same as the other secrets.
PAYPAL_MERCHANT_ID=
# Sandbox only. Do not point this at the live API for the hackathon demo.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Published PayPal sandbox test card (https://developer.paypal.com/tools/sandbox/card-testing/)
PAYPAL_TEST_CARD_NUMBER=4012888888881881
PAYPAL_TEST_CARD_EXPIRY=2030-12
PAYPAL_TEST_CARD_CVV=123

# Nebius Token Factory, OpenAI-compatible
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AGENT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
ROUTER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813

# replay (fixtures, labeled) or live (PayPal sandbox). Default: live when PayPal keys exist, otherwise replay.
MENDCASH_MODE=

# Spending caps. Repeats of the same buyer text are free. The $2 cap is the money stop.
MAX_DAILY_USD=2
MAX_ANALYSES_PER_IP=400
# Optional. Live mode uses the OS temp dir when this is empty.
# MENDCASH_STATE_FILE=
MAX_SIMULATIONS_PER_IP=5
MAX_CONCURRENCY=4
MAX_PARTIAL_REFUND_USD=200
MAX_SESSION_REFUND_USD=500

# Secondary invoice flow. Leave false until Invoicing is enabled on the sandbox app.
INVOICING_ENABLED=false

# Render sets PORT. Local default is 3000.
PORT=3000
# Set to 0 only when not behind a reverse proxy.
TRUST_PROXY=1

# Live sandbox seed (creates real sandbox orders and chargebacks). npm run seed stays offline unless this is 1.
SEED_LIVE=0
